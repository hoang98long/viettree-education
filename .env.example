# LOCAL DEVELOPMENT ONLY. Đổi mật khẩu và dùng DB role riêng trước production.
APP_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viettree-education
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=8
REMEMBER_SESSION_DAYS=7
SEED_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_ADMIN_PASSWORD
SEED_STUDENT_PASSWORD=CHANGE_ME_UNIQUE_STUDENT_PASSWORD
# Chỉ dùng bởi Next.js server; browser luôn gọi /api/v1 cùng origin.
INTERNAL_API_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1
AI_PROVIDER=simulation
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=
# AI_MEDIA_ROOT can point to a private writable upload directory.
