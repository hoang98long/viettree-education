# 4 vCPU / 8 GB RAM / 100 GB SSD. Location does not change Vietnamese study dates.
# Copy to .env.production, chmod 600 and replace all placeholders.
VIETTREE_DEPLOY_PROFILE=vps8gb
DOMAIN=hoc.example.com
ACME_EMAIL=admin@example.com
RELEASE=2026-10-15-vps8gb-v1
# Keep maintenance on until account review/check-launch passes.
# Set this allowlist to the operator's public IP/CIDR to access the setup UI.
MAINTENANCE_MODE=true
MAINTENANCE_ALLOWED_IPS=127.0.0.1/32 ::1/128
DB_NAME=viettree-education
DB_USER=viettree_app
DB_PASSWORD=CHANGE_ME_UNIQUE_APP_PASSWORD
DB_OWNER_PASSWORD=CHANGE_ME_UNIQUE_MIGRATION_PASSWORD
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_POSTGRES_PASSWORD
SESSION_HOURS=8
REMEMBER_SESSION_DAYS=7
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_POOL_SIZE=4
DB_POOL_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
SERVER_WORKERS=2
SERVER_LIMIT_CONCURRENCY=128
SERVER_GRACEFUL_TIMEOUT=30
BACKEND_STOP_GRACE_PERIOD=45s
PASSWORD_VERIFY_CONCURRENCY=2
AI_PROVIDER=simulation
AI_TRAINING_ONLY=true
AI_OLLAMA_URL=http://ollama:11434
AI_OLLAMA_MODEL=
